# ══════════════════════════════════════════════════════════════════════════════
# .gitignore — LCA Analysis Project
# ══════════════════════════════════════════════════════════════════════════════

# ── Participant data (NEVER commit raw data) ──────────────────────────────────
# The data/raw/ subfolder is fully excluded. data/README.md is still tracked.
data/raw/

# ── Analysis outputs (generated by the script; reproducible from code) ────────
# All files inside results/ are excluded except results/README.md.
results/*
!results/README.md

# ── renv package library (renv.lock IS committed; the library is NOT) ─────────
renv/library/
renv/staging/
renv/sandbox/

# ── R artefacts ───────────────────────────────────────────────────────────────
.Rhistory
.RData
.Rproj.user/
*.Rproj

# ── OS artefacts ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Temporary / editor files ──────────────────────────────────────────────────
*.tmp
*.bak
*~
